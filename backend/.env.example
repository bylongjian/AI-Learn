# Copy to .env and supply your own key. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# This is the total budget across all attempts, not a per-attempt budget (max 45).
GENERATION_TIMEOUT_SECONDS=45
GENERATION_RETRIES=1
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=1024
MAX_BODY_BYTES=65536
CORS_ORIGINS=["http://localhost:10086","http://127.0.0.1:10086"]
BLOCKED_TERMS=["儿童色情","炸弹制作教程"]

# User features are optional. Leave MYSQL_USER/MYSQL_DATABASE empty for guests only.
APP_ENV=development
DEV_LOGIN_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Generate a private random value (at least 32 bytes); there is no fallback key.
JWT_SECRET=
JWT_EXPIRE_SECONDS=604800
WECHAT_APP_ID=
WECHAT_APP_SECRET=
