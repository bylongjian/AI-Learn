# 学习咩 AI 闯关学习小程序 - 后端环境配置
# 复制为 .env 后按实际环境填写。修改后重启后端，密钥不要提交到 Git。

# DeepSeek 大模型配置
# 填写 DeepSeek 密钥，留空时无法调用模型。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Tavily 联网搜索配置（用于出题前获取最新知识）
TAVILY_API_KEY=
# true 开启联网；false 关闭联网。普通出题资料不足时暂停，文档出题可转模型兜底。
ENABLE_WEB_SEARCH=true

# 私有知识库：百炼向量化（未配置时拒绝新上传，普通学习仍可用）
# Key 与业务空间地址必须属于同一地域；不要填写占位符或把真实 Key 提交到 Git。
DASHSCOPE_API_KEY=
# 到百炼控制台复制 OpenAI 兼容 Base URL，结尾为 /compatible-mode/v1。
# 北京地址示例：https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# 同一集合维度固定；更换模型、地域或维度后旧文档须删除重传。
KB_EMBEDDING_DIMENSIONS=1024
# 相对路径以 backend 为基准，本地 Chroma 只允许一个 API worker 写入。
CHROMA_PERSIST_DIR=data/chroma
KB_UPLOAD_DIR=data/uploads
# 每人文档数和单文件 MB 上限；失败及未彻底删除的文档也占名额，无每日次数限制。
KB_MAX_DOCUMENTS_PER_USER=10
KB_MAX_FILE_SIZE_MB=10
# 从接受上传起含排队的处理秒数，以及单次文档资料准备秒数。
KB_PROCESS_TIMEOUT_SECONDS=180
KB_RETRIEVAL_TIMEOUT_SECONDS=8
# 按字符分块；相邻片段重叠字符数和每次检索片段数。
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_RETRIEVE_TOP_K=4
# 每次向量化两段；后台最多同时处理两篇。
KB_EMBEDDING_BATCH_SIZE=2
KB_PROCESS_CONCURRENCY=2

# 出题与资料检查预算（时间单位：秒）
# 资料获取与领域判断的总时限。
KNOWLEDGE_TIMEOUT_SECONDS=25
# 出题、依据检查和一次修正共用的时限。
QUIZ_BUILD_TIMEOUT_SECONDS=25
# 包含最终保存的请求总时限，最多 55 秒，必须大于前两个阶段预算之和。
QUIZ_REQUEST_TIMEOUT_SECONDS=55
# 每次准备最多四次外部工具调用，资料总字符数最多 12000。
KNOWLEDGE_MAX_TOOL_CALLS=4
KNOWLEDGE_MAX_CONTEXT_CHARS=12000
# 单条模型生成链的全部尝试总时限，最多 45 秒；格式错误时的额外重试次数。
GENERATION_TIMEOUT_SECONDS=45
GENERATION_RETRIES=1

# 后端环境与本地调试
# development 开发、test 测试、production 生产。
APP_ENV=development
# 是否启用本机测试登录，只能在开发环境使用。
DEV_LOGIN_ENABLED=false

# MySQL 数据库配置（游客模式可以不配置）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 登录凭证配置
# 请使用私有随机签名密钥，不要公开；登录有效期单位为秒，默认 7 天。
JWT_SECRET=
JWT_EXPIRE_SECONDS=604800

# 微信小程序配置
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 请求频率与内容限制
# 每个客户端在一个时间窗口内的请求次数、窗口秒数及最多记录的客户端数。
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=1024
# 请求体大小上限，单位为字节。
MAX_BODY_BYTES=65536
# 允许访问后端的 H5 地址与需要拦截的内容关键词，均使用 JSON 数组。
CORS_ORIGINS=["http://localhost:10086","http://127.0.0.1:10086"]
BLOCKED_TERMS=["儿童色情","炸弹制作教程"]
